# =============================================
# 环境变量配置模板
# 使用方式：复制本文件为 .env 并修改对应值
#   cp .env.example .env
# =============================================

# ---------- 应用环境 ----------
# dev | prod（对应 Spring Boot profile）
SPRING_PROFILES_ACTIVE=prod

# ---------- 数据库 MySQL ----------
DB_NAME=permission_admin
# ⚠️ 生产环境务必修改为强密码
DB_PASSWORD=123456abc

# ---------- Redis ----------
# ⚠️ 生产环境务必设置密码
REDIS_PASSWORD=your_redis_password
REDIS_DATABASE=1

# ---------- JWT 密钥 ----------
# 生成方式：openssl rand -base64 48
# ⚠️ 生产环境必须设置，否则 token 可被伪造
JWT_SECRET_KEY=

# ---------- 端口映射 ----------
# 宿主机端口:容器端口（修改左侧即可）
MYSQL_PORT=3306
REDIS_PORT=6379
BACKEND_PORT=8080
FRONTEND_PORT=80
